# ─── Circle Developer-Controlled Wallets ────────────────────────────────────
# Console: https://console.circle.com  →  API & Client Keys
CIRCLE_API_KEY=
# Generate once with generateEntitySecret() from the SDK, then register it
# with registerEntitySecretCiphertext(). NEVER commit this. NEVER log it.
CIRCLE_ENTITY_SECRET=
# The Wallet Set that groups all TelePort treasury wallets (created once, see
# scripts/bootstrap-wallet-set.ts)
CIRCLE_WALLET_SET_ID=

# ─── Circle Gateway (unified USDC balance across chains) ───────────────────
# Testnet: https://gateway-api-testnet.circle.com/v1
GATEWAY_API_BASE_URL=https://gateway-api-testnet.circle.com/v1

# ─── Circle Bridge Kit / CCTP Forwarding Service ───────────────────────────
# App Kit key from Console → Bridge Kit (server-side only, never exposed to
# the browser)
CIRCLE_KIT_KEY=

# ─── Network ─────────────────────────────────────────────────────────────
# "testnet" everywhere until you deliberately promote to mainnet.
NETWORK_ENV=testnet

# Platform fee charged to the sender in USDC, in basis points. 100 = 1.00%.
PAYMENT_FEE_BPS=100
# Receives the platform fee in the destination chain of every Gateway payment.
# This must be an EVM address controlled by your platform.
PLATFORM_FEE_RECIPIENT=

# ─── Supabase ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, used by API routes that need to bypass RLS
# (e.g. writing transfer records). NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Webhook verification (Circle notifications, optional but recommended) ─
